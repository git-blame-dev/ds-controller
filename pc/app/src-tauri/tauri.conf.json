{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Controller",
  "version": "0.1.0",
  "identifier": "dev.gitblame.ds-controller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DS Controller",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Nintendo DS Wi-Fi controller receiver",
    "longDescription": "Receive Nintendo DS button input over UDP and expose it through a virtual game controller.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-ds-controller-uinput.rules": "linux/70-ds-controller-uinput.rules"
        },
        "postInstallScript": "linux/reload-uinput-rules.sh",
        "postRemoveScript": "linux/reload-uinput-rules.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/git-blame-dev/ds-controller/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODgxNEE4MjM5RTcyNEIKUldSTGNwNGpxQlNJUWpxYXpEZWhqVHFMcStZNi9YSTI0OXlvM1BXdklaSVY4Z0w4ZkZlNUZ5Ym4K"
    }
  }
}
